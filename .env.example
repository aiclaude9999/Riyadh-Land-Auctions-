# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auctions
# Redis (BullMQ)
REDIS_URL=redis://localhost:6379
# Logging: info | debug | warn ; LOG_PRETTY=1 for human-readable logs
LOG_LEVEL=info
LOG_PRETTY=1
# Number of scrape jobs processed in parallel (different sources)
WORKER_CONCURRENCY=3
# Optional: custom scraper UA / Chromium binary / proxy for Playwright
# SCRAPER_USER_AGENT=
# CHROMIUM_PATH=/usr/bin/chromium
# PLAYWRIGHT_PROXY=http://user:pass@host:port
# Optional Telegram channel (also enable it in Settings → Telegram)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
