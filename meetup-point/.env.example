# Server-only key (never sent to the browser). Enable: Places API (New), Routes API.
GOOGLE_MAPS_API_KEY=

# Separate browser key, restricted by HTTP referrer (e.g. http://localhost:3000/*)
# and to the "Maps JavaScript API" only.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Optional: a Map ID from Google Cloud (Map Management). DEMO_MAP_ID works for development.
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID

# Shared groups (sharing + voting). Vercel's "Upstash for Redis" integration sets these two for you.
# Without them the app keeps groups in memory: links then only work on the same computer.
KV_REST_API_URL=
KV_REST_API_TOKEN=
