# Single-container image for hosting: web app + background worker (see scripts/start-all.sh).
# Browser-based sources are disabled on the host (DISABLE_BROWSER_SOURCES=1), so no Chromium is installed.
FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx prisma generate && npx next build
ENV NODE_ENV=production
EXPOSE 3000
CMD ["sh", "scripts/start-all.sh"]
